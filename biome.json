{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!.serena",
			"!.claude",
			"!package-lock.json",
			"!**/routeTree.gen.ts",
			"!**/dist",
			"!**/.output"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUndeclaredVariables": "error"
			},
			"style": {
				"useImportType": "error",
				"noNonNullAssertion": "error",
				"useConst": "error",
				"noParameterAssign": "error",
				"useTemplate": "error",
				"noInferrableTypes": "error",
				"useNodejsImportProtocol": "error",
				"useShorthandFunctionType": "error",
				"noUselessElse": "error",
				"noMagicNumbers": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noEvolvingTypes": "error",
				"noConfusingVoidType": "error",
				"noMisleadingInstantiator": "error"
			},
			"complexity": {
				"noForEach": "error",
				"useLiteralKeys": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error"
			}
		},
		"domains": {
			"react": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*_tests.ts",
				"**/*_tests.tsx",
				"**/*_tests.mjs",
				"**/*_integration_tests.ts",
				"**/*_integration_tests.tsx",
				"**/bdd/**",
				"apps/*-e2e/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noMagicNumbers": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/flash-load/k6/**"],
			"javascript": {
				"globals": ["__ENV"]
			}
		},
		{
			"includes": [
				"apps/*/src/**",
				"libs/*/src/**",
				"!**/*_tests.ts",
				"!**/*_tests.tsx",
				"!**/*_integration_tests.ts",
				"!**/*_integration_tests.tsx",
				"!**/bdd/**",
				"!libs/typekit/src/boundary.ts"
			],
			"plugins": ["./.biome/no-catch.grit"]
		}
	]
}
