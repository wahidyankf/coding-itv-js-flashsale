{
	"name": "coding-itv-js-flashsale",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"prepare": "husky",
		"format": "biome format --write .",
		"lint": "biome check --error-on-warnings .",
		"docs:install": "sh scripts/install-rhino.sh",
		"docs:check": "sh scripts/check-docs.sh",
		"bdd:check": "node scripts/bdd/check-behaviour-coverage.mjs",
		"bdd:check:test": "vitest run --config scripts/bdd/vitest.config.mjs",
		"lint:rules:test": "vitest run --config scripts/lint/vitest.config.mjs",
		"build:script:test": "vitest run --config scripts/compile/vitest.config.mjs",
		"trace:script:test": "vitest run --config scripts/trace/vitest.config.mjs",
		"docker:dev:up": "docker compose -f compose.dev.yaml up -d --wait",
		"docker:dev:down": "docker compose -f compose.dev.yaml down",
		"docker:prod:up": "docker compose -f compose.prod.yaml up -d --build --wait",
		"docker:prod:down": "docker compose -f compose.prod.yaml down",
		"prod:create-operator": "docker compose -f compose.prod.yaml exec flash-be-1 node dist/create-operator.js",
		"prod:seed-sale": "docker compose -f compose.prod.yaml exec flash-be-1 node dist/seed-sale.js",
		"prod:logs": "docker compose -f compose.prod.yaml logs -f",
		"prod:trace": "npx nx build typekit && npx nx build flash-commons && node scripts/trace/trace.mjs",
		"smoke:prod": "npx nx build typekit && npx nx build flash-commons && node scripts/smoke/prod.mjs",
		"demo:reset": "npx nx db:reset flash-be",
		"demo:operator": "npx nx db:create-operator flash-be --username=ops --password=correct-horse-battery --output-style=stream",
		"demo:sale": "npx nx db:seed-sale flash-be --stock=3 --starts-in-minutes=0 --duration-minutes=60 --hold-seconds=60 --output-style=stream",
		"demo:setup": "npx nx db:up flash-be && npx nx db:migrate flash-be && { out=$(npm run demo:operator 2>&1); code=$?; printf '%s\\n' \"$out\"; [ \"$code\" -eq 0 ] || case \"$out\" in *'the user ops already exists'*) echo 'ops already exists, going on';; *) exit 1;; esac; } && npm run demo:sale",
		"demo:dev": "npx nx run-many -t dev -p flash-be flash-web --output-style=stream",
		"demo:redis:stop": "docker compose -f compose.dev.yaml stop redis",
		"demo:redis:start": "docker compose -f compose.dev.yaml up -d --wait redis",
		"demo:load": "npx nx load:smoke flash-load --output-style=stream",
		"demo:deleted-sale": "docker compose -f compose.dev.yaml exec postgres psql -U flash -d flash -c \"SELECT s.name, s.deleted_at, u.username AS deleted_by FROM sales s JOIN users u ON u.id = s.deleted_by ORDER BY s.deleted_at DESC LIMIT 1\"",
		"load:down": "docker compose -f apps/flash-load/compose.yaml down -v"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wahidyankf/coding-itv-js-flashsale.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/wahidyankf/coding-itv-js-flashsale/issues"
	},
	"homepage": "https://github.com/wahidyankf/coding-itv-js-flashsale#readme",
	"devDependencies": {
		"@amiceli/vitest-cucumber": "^8.0.0",
		"@biomejs/biome": "^2.6.4",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@cucumber/gherkin": "^42.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"nx": "^24.0.4",
		"playwright-bdd": "^9.2.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"minimatch": "^11.0.4"
	},
	"volta": {
		"node": "26.13.0",
		"npm": "12.2.1"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}": "biome format --write --no-errors-on-unmatched"
	},
	"workspaces": [
		"libs/typekit",
		"libs/flash-commons",
		"apps/flash-be",
		"apps/flash-be-e2e",
		"apps/flash-web",
		"apps/flash-web-e2e",
		"apps/flash-load"
	]
}
