{
	"name": "@flash/contract",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The HTTP contract of the flash sale API: routes, request and reply shapes, error codes and format rules.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vocabulary": {
			"types": "./dist/vocabulary.d.ts",
			"default": "./dist/vocabulary.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint --error-on-warnings .",
		"test:unit": "vitest run --config vitest.config.ts --coverage.enabled",
		"test:coverage": "vitest run --config vitest.config.ts --coverage.enabled",
		"test:unit:watch": "vitest --config vitest.config.ts"
	},
	"dependencies": {
		"@flash/typekit": "*",
		"zod": "^4.6.7"
	}
}
