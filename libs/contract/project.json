{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "contract",
	"projectType": "library",
	"sourceRoot": "libs/contract/src",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "npm run build",
				"cwd": "libs/contract"
			},
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run typecheck",
				"cwd": "libs/contract"
			},
			"dependsOn": ["^build"]
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run lint",
				"cwd": "libs/contract"
			},
			"dependsOn": ["^build"]
		},
		"test:unit": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run test:unit",
				"cwd": "libs/contract"
			},
			"dependsOn": ["^build"]
		},
		"test:unit:watch": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run test:unit:watch",
				"cwd": "libs/contract"
			},
			"dependsOn": ["^build"]
		},
		"test:coverage": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run test:coverage",
				"cwd": "libs/contract"
			},
			"dependsOn": ["^build"]
		},
		"test:quick": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"npx nx typecheck contract",
					"npx nx lint contract",
					"npx nx test:unit contract"
				],
				"cwd": ".",
				"parallel": false
			}
		},
		"test:quick:watch": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx nx watch --projects=contract --initialRun -- npx nx run-many -t typecheck lint test:unit -p contract --output-style=stream",
				"cwd": "."
			}
		}
	}
}
