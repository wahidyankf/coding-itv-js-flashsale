{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "typekit",
	"projectType": "library",
	"sourceRoot": "libs/typekit/src",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "npm run build",
				"cwd": "libs/typekit"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run typecheck",
				"cwd": "libs/typekit"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run lint",
				"cwd": "libs/typekit"
			}
		},
		"test:unit": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run test:unit",
				"cwd": "libs/typekit"
			}
		},
		"test:unit:watch": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run test:unit:watch",
				"cwd": "libs/typekit"
			}
		},
		"test:coverage": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run test:coverage",
				"cwd": "libs/typekit"
			}
		},
		"test:quick": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"npx nx typecheck typekit",
					"npx nx lint typekit",
					"npx nx test:unit typekit"
				],
				"cwd": ".",
				"parallel": false
			}
		},
		"test:quick:watch": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx nx watch --projects=typekit --initialRun -- npx nx run-many -t typecheck lint test:unit -p typekit --output-style=stream",
				"cwd": "."
			}
		}
	}
}
