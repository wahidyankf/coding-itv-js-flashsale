{
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"name": "flash-commons",
	"projectType": "library",
	"sourceRoot": "libs/flash-commons/src",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["typekit"],
					"target": "build"
				}
			],
			"outputs": ["{projectRoot}/dist"],
			"options": {
				"command": "npm run build",
				"cwd": "libs/flash-commons"
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["typekit"],
					"target": "build"
				}
			],
			"options": {
				"command": "npm run typecheck",
				"cwd": "libs/flash-commons"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run lint",
				"cwd": "libs/flash-commons"
			}
		},
		"test:unit": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["typekit"],
					"target": "build"
				}
			],
			"options": {
				"command": "npm run test:unit",
				"cwd": "libs/flash-commons"
			}
		},
		"test:unit:watch": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["typekit"],
					"target": "build"
				}
			],
			"options": {
				"command": "npm run test:unit:watch",
				"cwd": "libs/flash-commons"
			}
		},
		"test:coverage": {
			"executor": "nx:run-commands",
			"dependsOn": [
				{
					"projects": ["typekit"],
					"target": "build"
				}
			],
			"options": {
				"command": "npm run test:coverage",
				"cwd": "libs/flash-commons"
			}
		},
		"test:quick": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"npx nx typecheck flash-commons",
					"npx nx lint flash-commons",
					"npx nx test:unit flash-commons"
				],
				"cwd": ".",
				"parallel": false
			}
		},
		"test:quick:watch": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx nx watch --projects=flash-commons --initialRun -- npx nx run-many -t typecheck lint test:unit -p flash-commons --output-style=stream",
				"cwd": "."
			}
		}
	}
}
