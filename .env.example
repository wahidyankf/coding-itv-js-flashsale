# Local development only. These values are not secrets. Copy to .env and change them if you need to.
# Docker Compose reads this file for interpolation. Apps read it through Node's --env-file-if-exists.

# Postgres (compose.dev.yaml and compose.prod.yaml)
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash
POSTGRES_DB=flash
POSTGRES_PORT=5432

# Redis (host port)
REDIS_PORT=6379

# flash-be (host)
DATABASE_URL=postgres://flash:flash@localhost:5432/flash
REDIS_URL=redis://localhost:6379
FLASH_BE_HOST=::
FLASH_BE_PORT=8080
# Signs the queue tickets. Every flash-be instance must share it. Required in production; use a long random value.
TICKET_SECRET=local-development-ticket-secret
# How often the queue admits the next shoppers, and how long an admission stays valid.
ADMISSION_TICK_MS=1000
ADMISSION_TTL_SECONDS=600

# flash-web (host): where the server function reaches flash-be
FLASH_BE_URL=http://localhost:8080

# Host port for flash-web when running compose.prod.yaml
FLASH_WEB_PORT=3000
