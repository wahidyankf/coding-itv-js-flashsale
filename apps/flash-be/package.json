{
	"name": "flash-be",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=../../.env dist/main.js",
		"migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
		"migrate:dist": "node --env-file-if-exists=../../.env dist/migrate.js",
		"seed-sale": "node --env-file-if-exists=../../.env --import tsx src/seed-sale.ts",
		"seed-sale:dist": "node --env-file-if-exists=../../.env dist/seed-sale.js",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint --error-on-warnings .",
		"test:unit": "vitest run --config vitest.config.ts --coverage.enabled",
		"test:coverage": "vitest run --config vitest.coverage.config.ts",
		"test:unit:watch": "vitest --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@flash/contract": "*",
		"@flash/typekit": "*",
		"fastify": "^5.12.8",
		"fastify-type-provider-zod": "^7.0.0",
		"kysely": "^0.29.8",
		"pg": "^8.23.1",
		"redis": "^6.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@fastify/swagger": "^9.9.3",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15"
	}
}
