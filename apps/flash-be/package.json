{
	"name": "flash-be",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=../../.env dist/main.js",
		"migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
		"migrate:dist": "node --env-file-if-exists=../../.env dist/migrate.js",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint .",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:unit:watch": "vitest --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"fastify": "^5.12.8",
		"kysely": "^0.29.8",
		"pg": "^8.23.1",
		"redis": "^6.3.1"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15"
	}
}
