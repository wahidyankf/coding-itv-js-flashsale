{
	"name": "flash-be",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
		"build": "node ../../scripts/compile/build-dist.mjs",
		"start": "node --env-file-if-exists=../../.env dist/main.js",
		"migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
		"seed-sale": "node --env-file-if-exists=../../.env --import tsx src/seed-sale.ts",
		"create-operator": "node --env-file-if-exists=../../.env --import tsx src/create-operator.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint --error-on-warnings .",
		"test:unit": "vitest run --config vitest.config.ts --coverage.enabled",
		"test:coverage": "vitest run --config vitest.coverage.config.ts",
		"test:unit:watch": "vitest --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@flash/flash-commons": "*",
		"@flash/typekit": "*",
		"fastify": "^5.12.8",
		"kysely": "^0.29.8",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"redis": "^6.3.1"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15"
	}
}
