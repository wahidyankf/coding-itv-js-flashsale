{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "vitest.config.ts", "vitest.integration.config.ts"]
}
