# Every route of the flash-be API, one request each, grouped as in docs/reference/http-endpoints.md (the replies and
# every error are there). The demo story is api-flash-demo.http.
#
# Before you start: `npm run demo:setup` (the dev stack, the migrations, the operator `ops` and a sale), then
# `npx nx dev flash-be`.
#
# The format is kulala.nvim (https://github.com/wahidyankf/kulala.nvim). A request named with `# @name` keeps its
# reply, and later requests read the sale id, the ticket and the reservation id from it: send "the current sale",
# "join the queue" and "hold one item" before the requests that use them. The Shared block attaches kulala's cookie jar
# to every request, so a login is kept like in a browser. The API runs with COOKIE_SECURE=false locally, so the cookies
# work over plain HTTP.

### Shared
# @attach-cookie-jar
@backend = http://localhost:8080

###############################################################################
# Health
###############################################################################

### Liveness (no dependencies, always 200)
GET {{backend}}/health

### Readiness (Postgres and Redis; 503 when one fails)
GET {{backend}}/ready

###############################################################################
# The sale (public reads, cached for up to SALE_CACHE_MS)
###############################################################################

### The current sale (the running one, else the next to open, else 404 sale_not_found)
# @name current
GET {{backend}}/api/v1/sales/current

### One sale by id (404 sale_not_found for an unknown or malformed id)
GET {{backend}}/api/v1/sales/{{current.response.body.$.id}}

### Live sale status (Server-Sent Events: event: sale; curl closes it after 5 seconds here)
# @accept chunked
# @curl-max-time 5
GET {{backend}}/api/v1/sales/{{current.response.body.$.id}}/events

###############################################################################
# Operator routes (401 not_authenticated without a login, 403 forbidden for a shopper)
###############################################################################

### Log in as the operator (made with `npx nx db:create-operator flash-be --username=ops --password=correct-horse-battery`)
POST {{backend}}/api/v1/auth/login
Content-Type: application/json

{ "username": "ops", "password": "correct-horse-battery" }

### Create a sale (201; optional: name, productId, holdSeconds, admitPerSecond; 409 sale_overlaps when the window overlaps)
# @name created
POST {{backend}}/api/v1/admin/sales
Content-Type: application/json

{ "stock": 100, "startsAt": "2036-01-01T12:00:00Z", "endsAt": "2036-01-01T13:00:00Z" }

### List every sale (latest start first, with sold, holdSeconds and admitPerSecond)
GET {{backend}}/api/v1/admin/sales

### Change a sale (only the fields sent: name, stock, startsAt, endsAt, holdSeconds, admitPerSecond; 409 sale_locked)
PATCH {{backend}}/api/v1/admin/sales/{{created.response.body.$.id}}
Content-Type: application/json

{ "stock": 150 }

### Remove a sale (soft delete; 409 sale_has_purchases when someone bought)
DELETE {{backend}}/api/v1/admin/sales/{{created.response.body.$.id}}

###############################################################################
# Accounts and login (the shopper logged in here is the one the queue routes below use)
###############################################################################

### Sign up as a shopper (201 and the two cookies; 409 username_taken; a password has 8 to 128 characters)
POST {{backend}}/api/v1/auth/register
Content-Type: application/json

{ "username": "shopper-api", "password": "a long password" }

### Log in (200 and the two cookies; the same 401 invalid_credentials for a wrong name and a wrong password)
POST {{backend}}/api/v1/auth/login
Content-Type: application/json

{ "username": "shopper-api", "password": "a long password" }

### Who am I? (401 not_authenticated with no login)
GET {{backend}}/api/v1/auth/me

### Renew the login (the refresh cookie is sent to /api/v1/auth only; a new pair is set; replaying the old one ends the session)
POST {{backend}}/api/v1/auth/refresh

###############################################################################
# The waiting queue (log in as a shopper first; POST queue, reservations and purchases can answer 429 with
# Retry-After, as can the auth and operator routes)
###############################################################################

### Join the queue (201 on a new place, 200 when you have one; the reply holds the ticket)
# @name join
POST {{backend}}/api/v1/sales/{{current.response.body.$.id}}/queue

### Check your place (waiting with a place, or admitted; 404 not_in_queue when the place was lost; the delay lets one admission tick pass)
# @delay 1500
GET {{backend}}/api/v1/sales/{{current.response.body.$.id}}/queue/me
x-queue-ticket: {{join.response.body.$.ticket}}

### Live place in the queue (Server-Sent Events: event: place; curl closes it after 5 seconds here)
# @accept chunked
# @curl-max-time 5
GET {{backend}}/api/v1/sales/{{current.response.body.$.id}}/queue/me/events
x-queue-ticket: {{join.response.body.$.ticket}}

###############################################################################
# Holds and purchases
###############################################################################

### Hold one item (201 on a new hold, 200 for the same hold; 403 not_admitted while waiting)
# @name reserve
POST {{backend}}/api/v1/sales/{{current.response.body.$.id}}/reservations
x-queue-ticket: {{join.response.body.$.ticket}}

### Pay for the held item (201, or 200 with the same purchase when sent again; 402 payment_failed keeps the hold)
POST {{backend}}/api/v1/sales/{{current.response.body.$.id}}/purchases
Content-Type: application/json

{ "reservationId": "{{reserve.response.body.$.reservationId}}" }

### Did I get it? (purchased, holding or none)
GET {{backend}}/api/v1/sales/{{current.response.body.$.id}}/purchases/me

###############################################################################
# The end of the session
###############################################################################

### Log out (ends the session and clears the cookies; safe to send twice)
POST {{backend}}/api/v1/auth/logout
